name: iridium
title: Iridium
base: core24
version: "$RELEASE_VERSION"
summary: Fast, private code editor with a familiar layout
description: |
  Iridium is a code editor based on Zed: Zed's speed and low memory use, with a
  layout familiar from VS Code, no account, no telemetry and no downloads without
  asking.
grade: stable
confinement: classic
compression: lzo
website: https://github.com/pbarovsky/iridium
source-code: https://github.com/pbarovsky/iridium
issues: https://github.com/pbarovsky/iridium/issues

parts:
  iridium:
    plugin: dump
    source: "https://github.com/pbarovsky/iridium/releases/download/v$RELEASE_VERSION/iridium-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  iridium:
    command: usr/bin/iridium
    common-id: io.github.pbarovsky.Iridium
    environment:
      ZED_BUNDLE_TYPE: snap
