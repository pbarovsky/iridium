<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>$APP_ID</id>
    <metadata_license>MIT</metadata_license>
    <project_license>Apache-2.0 and GPL-3.0-or-later</project_license>

    <name>$APP_NAME</name>
    <summary>Fast, private code editor with a familiar layout</summary>
    <developer id="io.github.pbarovsky">
        <name translate="no">pbarovsky</name>
    </developer>
    <description>
        <p>
            Iridium is a code editor based on Zed: Zed's speed and low memory use, with a layout familiar from VS Code, no account, no telemetry and no downloads without asking.
        </p>
    </description>

    <launchable type="desktop-id">$APP_ID.desktop</launchable>

    <branding>
        <color type="primary" scheme_preference="light">$BRANDING_LIGHT</color>
        <color type="primary" scheme_preference="dark">$BRANDING_DARK</color>
    </branding>

    <content_rating type="oars-1.1">
    </content_rating>

    <url type="homepage">https://github.com/pbarovsky/iridium</url>
    <url type="bugtracker">https://github.com/pbarovsky/iridium/issues</url>
    <url type="vcs-browser">https://github.com/pbarovsky/iridium</url>

    <supports>
        <internet>offline-only</internet>
    </supports>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
        <display_length compare="ge">768</display_length>
    </recommends>


    <releases>
		@release_info@
		<release version="0.0.0" date="1970-01-01">
			<description>
				<p>Dummy release to keep flatpak-builder AppStream metadata validation from complaining</p>
			</description>
		</release>
    </releases>
</component>
