#!/usr/bin/env bash

set -euxo pipefail

if [[ $# -gt 0 ]]; then
  echo "
  Usage: ${0##*/}
  Builds and installs Iridium onto your system into ~/.local, making it available as ~/.local/bin/iridium.

  Iridium is installed next to Zed, never over it: ~/.local/iridium.app,
  ~/.local/bin/iridium and its own .desktop entry.

  Before running this you should ensure you have all the build dependencies installed with `./script/linux`.
  "
  exit 1
fi

channel=$(<crates/zed/RELEASE_CHANNEL)
export ZED_CHANNEL="$channel"
export ZED_UPDATE_EXPLANATION="You need to fetch and rebuild Iridium in $(pwd)"
script/bundle-linux --skip-sentry

arch="$(uname -m)"
archive="${CARGO_TARGET_DIR:-target}/release/iridium-linux-${arch}.tar.gz"

suffix=""
if [[ "$channel" != "stable" ]]; then
  suffix="-$channel"
fi

# Must match ReleaseChannel::app_id and script/bundle-linux.
case "$channel" in
  nightly) appid="io.github.pbarovsky.Iridium-Nightly" ;;
  preview) appid="io.github.pbarovsky.Iridium-Preview" ;;
  dev) appid="io.github.pbarovsky.Iridium-Dev" ;;
  *) appid="io.github.pbarovsky.Iridium" ;;
esac

app_dir="$HOME/.local/iridium$suffix.app"
rm -rf "$app_dir"
mkdir -p "$app_dir"
tar -xzf "$archive" -C "$HOME/.local/"

editor="$app_dir/libexec/iridium-editor"
if command -v ldd >/dev/null 2>&1; then
  missing="$(ldd "$editor" 2>/dev/null | sed -n 's/^[[:space:]]*\(.*\) => not found$/\1/p')"
  if [ -n "$missing" ]; then
    echo "Warning: your system is missing libraries that Iridium needs:"
    echo "$missing" | sed 's/^/    /'
  fi
fi

mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications"
ln -sf "$app_dir/bin/iridium" "$HOME/.local/bin/iridium"

desktop_file="$HOME/.local/share/applications/${appid}.desktop"
cp "$app_dir/share/applications/${appid}.desktop" "$desktop_file"
sed -i "s|Icon=iridium|Icon=$app_dir/share/icons/hicolor/512x512/apps/iridium.png|g" "$desktop_file"
sed -i "s|Exec=iridium|Exec=$app_dir/bin/iridium|g" "$desktop_file"

echo "Iridium is installed: run it with ~/.local/bin/iridium, or from the applications menu."
